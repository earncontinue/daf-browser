diff --git a/build/circular_includes_untriaged.gni b/build/circular_includes_untriaged.gni
index 6ce2c62..66c1a95 100644
--- a/build/circular_includes_untriaged.gni
+++ b/build/circular_includes_untriaged.gni
@@ -208,11 +208,6 @@ allow_circular_includes_from_untriaged = [
   "//chrome/browser:browser",
   "//chrome/installer/util:with_no_strings",
   "//chrome/test/base:chrome_test_utils",
-  "//chrome/test:browser_tests",
-  "//chrome/test:interactive_ui_tests",
-  "//chrome/test:test_support",
-  "//chrome/test:test_support_ui",
-  "//chrome/test:unit_tests",
   "//chromeos/ash/components/dbus/hermes:hermes_fakes",
   "//chromeos/ash/components/network:network",
   "//components/download/public/common:public",
